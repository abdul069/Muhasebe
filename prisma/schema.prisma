// Prisma schema voor het dijitale fis-platform
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma Postgres levert POSTGRES_URL als directe postgres://-connectie.
  // (PRISMA_DATABASE_URL bestaat apart voor de Accelerate-variant.)
  url      = env("POSTGRES_URL")
}

// Gebruiker: kan een KLANT (musteri) of een BOEKHOUDER (muhasebeci) zijn.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  companyName  String? // bedrijfsnaam van de klant
  role         String   @default("CLIENT") // "CLIENT" of "ACCOUNTANT"
  createdAt    DateTime @default(now())

  receipts Receipt[]
}

// Fis / kassabon
model Receipt {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // originele foto (Vercel Blob URL)
  imageUrl     String
  originalName String?
  mimeType     String?

  // OCR resultaat (ruwe tekst)
  ocrText      String?
  status       String    @default("PENDING") // PENDING | PROCESSED | FAILED
  docType      String    @default("RECEIPT") // RECEIPT (fiş) | Z_REPORT (Z raporu)

  // uit OCR geparste (en door boekhouder corrigeerbare) velden
  merchant     String? // winkel / leverancier
  receiptDate  DateTime? // datum op de bon
  totalAmount  Float? // totaalbedrag
  taxAmount    Float? // KDV (btw)
  currency     String?   @default("TRY")
  note         String? // vrije notitie

  vatLines     VatLine[] // KDV-uitsplitsing per tarief

  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@index([userId])
  @@index([status])
}

// KDV-regel: één per KDV-oran op een fiş / Z raporu.
model VatLine {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  rate      Float // KDV-oran in procenten (1, 10, 20, ...)
  base      Float? // matrah (belastbare grondslag)
  amount    Float // KDV-bedrag voor dit tarief

  @@index([receiptId])
}
