# Kopieer dit bestand naar .env en pas de waardes aan
# --------------------------------------------------

# --- Database (Prisma Postgres) ---
# Op Vercel zet de Prisma Postgres-integratie o.a. POSTGRES_URL (directe
# postgres://-connectie). Prisma gebruikt POSTGRES_URL (zie prisma/schema.prisma).
# Lokaal het snelst: `vercel env pull .env.local` haalt alle waarden op.
POSTGRES_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# --- Auth ---
# Geheime sleutel voor login-sessies (JWT). Genereer: openssl rand -base64 32
SESSION_SECRET="verander-dit-in-een-lange-willekeurige-string-minimaal-32-tekens"

# --- Bestandsopslag (Vercel Blob) ---
# Maak een Blob-store aan in het Vercel-dashboard; die zet BLOB_READ_WRITE_TOKEN.
# Lokaal nodig om foto-uploads te testen.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- OCR (client-side, in de browser) ---
# Talen voor Tesseract (Turks + Engels als fallback). Optioneel.
NEXT_PUBLIC_OCR_LANGS="tur+eng"
