# Kopieer dit bestand naar .env en pas de waardes aan
# --------------------------------------------------

# SQLite database bestand (voor productie: wissel naar Postgres in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Geheime sleutel voor het ondertekenen van login-sessies (JWT).
# Genereer een sterke waarde, bv: openssl rand -base64 32
SESSION_SECRET="verander-dit-in-een-lange-willekeurige-string-minimaal-32-tekens"

# Map waar de geuploade fis-fotos worden opgeslagen (relatief aan projectroot)
UPLOAD_DIR="./uploads"

# OCR talen voor Tesseract (Turks + Engels als fallback)
OCR_LANGS="tur+eng"
